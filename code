#include <iostream>
using namespace std;

class Node {
public:
    int value;
    Node* next;
    Node* previous;
    Node(int v) : value(v), next(nullptr), previous(nullptr) {}
};

class Staque {
private:
    Node* head;
    Node* tail;

public:
    // Constructor
    Staque() : head(nullptr), tail(nullptr) {}

    // Copy constructor
    Staque(const Staque& src) : head(nullptr), tail(nullptr) {
        Node* temp = src.head;
        while (temp) {
            push(temp->value);
            temp = temp->next;
        }
    }

    // Destructor
    ~Staque() {
        clear();
    }

    // Overloaded assignment operator
    Staque& operator=(const Staque& src) {
        if (this == &src) return *this;
        clear();
        Node* temp = src.head;
        while (temp) {
            push(temp->value);
            temp = temp->next;
        }
        return *this;
    }

    // Insert based on value parity
    void push(int num) {
        Node* newNode = new Node(num);
        if (num % 2 == 0) {  // Place even numbers at head
            newNode->next = head;
            if (head) head->previous = newNode;
            head = newNode;
            if (!tail) tail = head;
        } else {  // Place odd numbers at tail
            newNode->previous = tail;
            if (tail) tail->next = newNode;
            tail = newNode;
            if (!head) head = tail;
        }
    }

    // Display the current contents of the Staque
    void show() const {
        Node* temp = head;
        cout << "(Head) ";
        while (temp) {
            cout << temp->value << " ";
            temp = temp->next;
        }
        cout << "(Tail)" << endl;
    }

    // Remove one element from the head
    void popFront() {
        if (!head) return;
        Node* toDelete = head;
        head = head->next;
        if (head) head->previous = nullptr;
        else tail = nullptr;
        delete toDelete;
    }

    // Remove one element from the tail
    void popBack() {
        if (!tail) return;
        Node* toDelete = tail;
        tail = tail->previous;
        if (tail) tail->next = nullptr;
        else head = nullptr;
        delete toDelete;
    }

    // Remove specified count of even or odd elements
    void pop(int quantity, bool isOdd) {
        while (quantity > 0) {
            if (!head || !tail) break;
            if (isOdd) {
                if (tail->value % 2 != 0) {
                    popBack();
                    quantity--;
                } else break;
            } else {
                if (head->value % 2 == 0) {
                    popFront();
                    quantity--;
                } else break;
            }
        }
    }

    // Clear all elements in Staque
    void clear() {
        while (head) {
            Node* temp = head;
            head = head->next;
            delete temp;
        }
        tail = nullptr;
    }
};

int main() {
    Staque stq;
    int n, element;

    // Take input from user
    cout << "Enter the number of elements to add to the Staque: ";
    cin >> n;

    cout << "Enter " << n << " integers:" << endl;
    for (int i = 0; i < n; ++i) {
        cin >> element;
        stq.push(element);
    }

    cout << "\nStaque after insertion: ";
    stq.show();

    // Get the number of even and odd elements to remove
    int evenToRemove, oddToRemove;
    cout << "\nEnter the number of even elements to remove: ";
    cin >> evenToRemove;
    cout << "Enter the number of odd elements to remove: ";
    cin >> oddToRemove;

    // Remove the specified numbers
    stq.pop(evenToRemove, false);  // Remove even numbers from front
    stq.pop(oddToRemove, true);     // Remove odd numbers from back

    cout << "\nStaque after removal operations: ";
    stq.show();

    return 0;
}
